integrator              = md
dt                      = 0.001000
nsteps                  = 50000

continuation            = no
constraints             = none

cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
pbc                     = xyz
periodic-molecules      = yes

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.000000
ref-t                   = 300.000000

pcoupl                  = no

gen-vel                 = yes
gen-temp                = 300.000000
gen-seed                = 12345

nstxout                 = 5000
nstvout                 = 5000
nstfout                 = 5000
nstxout-compressed      = 5000
nstenergy               = 5000
nstlog                  = 5000
